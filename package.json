{
  "name": "california-tech",
  "version": "1.1.0",
  "type": "module",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev:sveltekit": "cross-env MODE=development vite dev --host",
    "dev:QWER": "node --no-warnings QWER watch",
    "dev:watch": "npm-run-all -p -r dev:QWER dev:sveltekit",
    "dev": "npm-run-all -s build:QWER dev:watch",
    "build:sveltekit": "vite build",
    "build:QWER_Without_Meta": "node --no-warnings QWER buildWithoutMeta",
    "build:QWER": "node --no-warnings QWER build",
    "build": "npm-run-all -s build:QWER build:sveltekit",
    "preview": "vite preview",
    "clean:sveltekit": "rimraf .svelte-kit",
    "clean:node_modules": "rimraf -- node_modules QWER/node_modules",
    "clean:routeFolder": "node --no-warnings QWER cleanEmptyFolders",
    "clean:QWER": "node --no-warnings QWER clean",
    "clean": "npm-run-all -s clean:QWER clean:routeFolder clean:sveltekit",
    "cleandeep": "npm-run-all -s clean clean:node_modules",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "format": "prettier --write .",
    "up:deps": "pnpm up -L -i",
    "up:QWER-deps": "cd QWER && pnpm up -L -i",
    "up": "npm-run-all -s up:deps up:QWER-deps",
    "changeset:add": "pnpm changeset add",
    "deploy:vercel-local-build": "vercel build --prod && vercel deploy --prebuilt --prod",
    "createblog": "bash utils/create-blog.sh",
    "symbiont:link": "bash scripts/symbiont-link.sh link",
    "symbiont:unlink": "bash scripts/symbiont-link.sh unlink",
    "symbiont:status": "bash scripts/symbiont-link.sh status",
    "backfill:image-sizes": "tsx scripts/imageSizeBackfill.ts",
    "symbiont:verify-tag": "bash scripts/verify-symbiont-tag.sh",
    "make:og-card": "tsx scripts/make-og-card.ts"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.2",
    "@eslint/js": "10.0.1",
    "@iconify-json/akar-icons": "1.2.7",
    "@iconify-json/bxs": "1.2.3",
    "@iconify-json/carbon": "1.2.26",
    "@iconify-json/fluent-emoji-flat": "1.2.6",
    "@iconify-json/ic": "1.2.4",
    "@iconify-json/line-md": "1.2.16",
    "@iconify-json/mdi": "1.2.3",
    "@iconify-json/tabler": "1.2.38",
    "@iconify-json/vscode-icons": "1.2.76",
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/adapter-vercel": "6.3.4",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@types/eslint": "9.6.1",
    "@types/nprogress": "0.2.3",
    "@typescript-eslint/eslint-plugin": "8.69.0",
    "@typescript-eslint/parser": "8.69.0",
    "@unocss/core": "66.10.0",
    "@unocss/extractor-svelte": "66.10.0",
    "@unocss/preset-icons": "66.10.0",
    "@unocss/preset-uno": "66.10.0",
    "@unocss/reset": "66.10.0",
    "@unocss/transformer-compile-class": "66.10.0",
    "@unocss/transformer-directives": "66.10.0",
    "@unocss/transformer-variant-group": "66.10.0",
    "axios": "^1.20.0",
    "bits-ui": "2.19.0",
    "chalk": "6.0.0",
    "chokidar": "5.0.0",
    "cross-env": "10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.23.0",
    "fs-extra": "11.4.0",
    "globals": "17.12.0",
    "gray-matter": "4.0.3",
    "html-to-text": "10.0.1",
    "image-size": "^2.0.2",
    "imagetools-core": "12.0.0",
    "katex": "0.18.7",
    "limax": "4.2.3",
    "lz-string": "1.5.0",
    "marked": "18.0.11",
    "marked-gfm-heading-id": "4.1.4",
    "marked-mangle": "1.1.13",
    "medium-zoom": "1.1.0",
    "npm-run-all": "4.1.5",
    "nprogress": "0.2.0",
    "pdf-to-img": "^7.0.0",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "prism-svelte": "0.5.0",
    "prismjs": "1.30.0",
    "probe-image-size": "7.4.0",
    "rimraf": "6.1.3",
    "sass": "1.104.0",
    "sharp": "0.35.4",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "svelte-preprocess": "6.0.5",
    "tippy.js": "6.3.7",
    "to-vfile": "8.0.0",
    "tslib": "2.8.1",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "unocss": "66.10.0",
    "unocss-preset-scrollbar": "4.0.0",
    "vite": "8.2.2",
    "vite-imagetools": "12.0.1",
    "wrangler": "^4.129.0"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "symbiont-cms": "github:guutz/symbiont-cms#v1.1.9"
  },
  "packageManager": "pnpm@11.22.0"
}
