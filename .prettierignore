# Recovered from the pre-split monorepo package, plus entries specific to this
# repo. Its absence is half of why `pnpm lint` was failing: prettier was trying
# to reformat pnpm-lock.yaml, the vendored QWER toolchain, and generated output.

.DS_Store
node_modules
/build
/.svelte-kit
/package

.env
.env.*
!.env.example

# Lockfiles -- never hand-format these
pnpm-lock.yaml
package-lock.json
yarn.lock

.vercel
.vercel_build_output

# Vendored upstream build tooling. Not ours to restyle, and reformatting it
# would make future diffs against upstream QWER unreadable.
/QWER

# Generated by `build:QWER` on every build (both are gitignored too)
/src/generated
/static

# Supabase CLI local state (contains the linked project ref)
/supabase/.temp

src/i18n/i18n-*
user/blogs/**
