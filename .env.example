# Example Environment Configuration for California Tech + Symbiont Integration

# ============================================================================
# NOT HERE: Supabase public configuration
# ============================================================================
# The project URL and publishable key are not environment variables. They live
# in src/lib/symbiont.ts, because they are public by design (RLS is what
# protects the data, not the key) and having them at build time keeps the
# client bundle from needing a runtime config fetch.
#
# This file used to declare VITE_PUBLIC_SUPABASE_URL and
# VITE_PUBLIC_SUPABASE_ANON_KEY. Nothing read them, so setting them did
# nothing and anyone reading this file was misled about where to change them.

# ============================================================================
# REQUIRED FOR SYNC: Server-Only Secrets
# ============================================================================
# Notion API token with access to your database
# Get from: https://www.notion.so/my-integrations
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase service role key (admin access for sync operations)
# Get from: Supabase Dashboard → Project Settings → API (service_role key)
# ⚠️ KEEP THIS SECRET - never expose in client code
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Secret for authenticating scheduled sync jobs (the daily /api/sync cron).
CRON_SECRET=your-random-secret-here

# Shared secret for the Notion webhook that drives near-realtime sync.
# The Notion automation sends it as the `x-symbiont-webhook-secret` header;
# /api/notion-webhook rejects anything else. symbiont reads it via
# requireEnvVar, so the endpoint throws on every request when it is unset --
# which is easy to miss, because the daily cron keeps working regardless and
# the site just looks slow to update rather than broken.
#
# Set this in Vercel. It is only needed wherever the webhook actually runs;
# local development can leave it blank and rely on `pnpm run sync` instead.
NOTION_WEBHOOK_SECRET=your-random-secret-here

# ============================================================================
# OPTIONAL: Google Doc import (pnpm run import:gdoc)
# ============================================================================
# OAuth client for reading Google Docs you have access to. Only needed if you
# import Docs into Notion; the site build does not use these.
# Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID
#   → Desktop app. Enable the Google Drive API on the same project.
# Refresh tokens are stored in ~/.config/california-tech/, not in this repo.
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-oauth-client-secret

# Largest upload the importer sends to Notion in one part, in bytes.
# Defaults to 20 MiB; only worth changing if Notion's limit moves.
# NOTION_SINGLE_PART_LIMIT=20971520
