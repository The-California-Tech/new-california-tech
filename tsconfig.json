{
  // SvelteKit 3 generates the parent (node_modules/$app/tsconfig.json) on
  // `svelte-kit sync`. Import aliases come from package.json "imports"
  // (#lib/*, #config/*, ...), not from here.
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "outDir": "build",
    "sourceMap": true,
    "strict": true,
    "types": ["$app/types", "vite/client"]
  },
  "include": ["src", "scripts", "*"],
  // src/lib/template holds QWER's code templates (not valid TS until filled
  // in); src/generated is QWER's output, regenerated on every build.
  "exclude": ["src/service-worker", "src/lib/template", "src/generated"]
}
